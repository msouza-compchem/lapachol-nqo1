; Steepest-descent energy minimisation
integrator      = steep
emtol           = 1000.0        ; kJ mol^-1 nm^-1
emstep          = 0.01
nsteps          = 50000

cutoff-scheme   = Verlet
coulombtype     = PME
rcoulomb        = 1.2
rvdw            = 1.2
vdw-modifier    = force-switch
rvdw-switch     = 1.0
pbc             = xyz
