; 100 ns production run, no restraints
integrator      = md
dt              = 0.002
nsteps          = 50000000      ; 100 ns
nstxout-compressed = 5000       ; a frame every 10 ps -> 10000 frames
compressed-x-grps  = Protein_LIG
nstlog          = 50000
nstenergy       = 50000

continuation    = yes
constraint_algorithm = lincs
constraints     = h-bonds
lincs_iter      = 1
lincs_order     = 4

cutoff-scheme   = Verlet
coulombtype     = PME
pme_order       = 4
fourierspacing  = 0.12
rcoulomb        = 1.2
rvdw            = 1.2
vdw-modifier    = force-switch
rvdw-switch     = 1.0
DispCorr        = no

tcoupl          = V-rescale
tc-grps         = Protein_LIG Water_and_ions
tau_t           = 0.1   0.1
ref_t           = 300   300

pcoupl          = C-rescale
pcoupltype      = isotropic
tau_p           = 2.0
ref_p           = 1.0
compressibility = 4.5e-5

pbc             = xyz
