NAME = 02_sp_solvent.inp
|  1> # ============================================================================
|  2> # Stage 1b: single-point energy on the optimised geometry
|  3> #   Level:  B3LYP-D4 / def2-TZVP with CPCM(water)
|  4> #   Why:    a larger basis and implicit solvent give far better frontier
|  5> #           orbital energies than the def2-SVP gas-phase optimisation.
|  6> #   Input geometry: ligand_opt.xyz, extracted from the Stage 1a output.
|  7> # ============================================================================
|  8> 
|  9> ! B3LYP D4 def2-TZVP def2/J RIJCOSX SP TightSCF
| 10> ! CPCM(water)
| 11> 
| 12> %maxcore 1500
| 13> %pal nprocs 4 end
| 14> 
| 15> # Print the orbital energies we need, and write a Molden file for VMD/Multiwfn
| 16> %output
| 17>   Print[P_MOs] 1
| 18>   Print[P_Basis] 2
| 19> end
| 20> 
| 21> %plots
| 22>   Format Gaussian_Cube
| 23>   dim1 80
| 24>   dim2 80
| 25>   dim3 80
| 26>   # Replace NN with the HOMO index reported in the Stage 1a output
| 27>   # MO("lapachol_homo.cube", NN, 0);
| 28>   # MO("lapachol_lumo.cube", NN+1, 0);
| 29> end
| 30> 
| 31> * xyzfile 0 1 ligand_opt.xyz
| 32> 
| 33>                          ****END OF INPUT****
